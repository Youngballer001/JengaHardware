NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/app/data/inquiries.sqlite
BACKUP_DIRECTORY=/app/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
ADMIN_USERNAME=school-office
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters

# SMTP email notification settings. Leave all SMTP fields empty to disable notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=
