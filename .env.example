# Jengo Hardware - Environment Configuration
# Copy this file to .env and update with your actual credentials

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=jengo_hardware

# Application Settings
APP_NAME="Jengo Hardware"
APP_URL=http://localhost/Jengo%20Hardware
APP_ENV=development
APP_DEBUG=true

# Security
SESSION_LIFETIME=7200
CSRF_TOKEN_LIFETIME=3600

# M-Pesa Configuration (Safaricom Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=your_security_credential_here
MPESA_CALLBACK_URL=https://your-domain.com/Jengo%20Hardware/payments/mpesa-callback.php

# M-Pesa API URLs
MPESA_BASE_URL_SANDBOX=https://sandbox.safaricom.co.ke
MPESA_BASE_URL_PRODUCTION=https://api.safaricom.co.ke

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_CALLBACK_URL=https://your-domain.com/Jengo%20Hardware/payments/paystack-callback.php
PAYSTACK_WEBHOOK_URL=https://your-domain.com/Jengo%20Hardware/payments/paystack-webhook.php

# Email Configuration (Optional - for notifications)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@jengohardware.com
MAIL_FROM_NAME="Jengo Hardware"

# SMS Configuration (Optional - Africa's Talking)
SMS_ENABLED=false
SMS_USERNAME=your_username
SMS_API_KEY=your_api_key
SMS_SENDER_ID=JENGO

# File Upload Settings
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

# Stock Settings
LOW_STOCK_THRESHOLD=10

# Delivery Fees (in KSh)
DELIVERY_FEE_STANDARD=300
DELIVERY_FEE_EXPRESS=600

# Logging
LOG_LEVEL=debug
LOG_PATH=config/storage/logs/

# Session Configuration
SESSION_COOKIE_NAME=jengo_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Timezone
APP_TIMEZONE=Africa/Nairobi

# Currency
CURRENCY_CODE=KES
CURRENCY_SYMBOL=KSh

# Pagination
PRODUCTS_PER_PAGE=12
ORDERS_PER_PAGE=20

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false

# Rate Limiting (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=60

# Cache
CACHE_ENABLED=false
CACHE_DRIVER=file
CACHE_TTL=3600

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We're currently performing maintenance. Please check back soon."

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# Social Media Links (Optional)
FACEBOOK_URL=
TWITTER_URL=
INSTAGRAM_URL=
WHATSAPP_NUMBER=

# Company Information
COMPANY_NAME="Jengo Hardware"
COMPANY_EMAIL=info@jengohardware.com
COMPANY_PHONE=+254700000000
COMPANY_ADDRESS="123 Main Street, Nairobi, Kenya"

# Support
SUPPORT_EMAIL=support@jengohardware.com
SUPPORT_PHONE=+254700000000

# Webhook Secret Keys (for verification)
MPESA_WEBHOOK_SECRET=your_webhook_secret_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_secret_key_here

# Testing
TEST_MODE=true
TEST_PHONE_NUMBER=254708374149
TEST_CARD_NUMBER=4084084084084081
