.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Node modules (if using any build tools)
node_modules/
npm-debug.log
yarn-error.log

# Composer (if using any PHP packages)
/vendor/
composer.phar
composer.lock

# Build files
/dist/
/build/

# Session files
sessions/*
!sessions/.gitkeep

# Test files
phpunit.xml
.phpunit.result.cache
tests/_output/*
tests/_support/_generated

# Backup files
*.bak
*.backup
*.old

# Documentation builds
/docs/_build/

