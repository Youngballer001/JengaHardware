*.sql.gz
*.sql.zip
backup_*.sql

# Logs
config/storage/logs/*.log
config/storage/logs/*.txt
*.log

# Cache
config/storage/cache/*
!config/storage/cache/.gitkeep

# Uploaded files
assets/images/products/*
!assets/images/products/.gitkeep

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

